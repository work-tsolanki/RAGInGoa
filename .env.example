# API Keys (get from services)
PINECONE_API_KEY=mock
ANTHROPIC_API_KEY=mock
# Sarvam AI: speech-to-text (Saarika model) for /query_audio. Get a key at
# https://dashboard.sarvam.ai (free tier available). Left as "mock",
# /query_audio fails fast with a 503 instead of silently mock-transcribing.
SARVAM_API_KEY=mock
# Groq: primary generation backend. Get a key at https://console.groq.com/keys
# Free tier: 30 req/min, 1,000-14,400 req/day depending on model - confirm
# it's enough before any paid usage. Leave unset to skip straight to the
# local/Claude fallbacks.
GROQ_API_KEY=
# Cerebras: benchmarked-but-not-promoted alternate backend, same Llama-3.1-8B
# weights as Groq on different (faster-claimed) silicon - speed/reliability
# test only. Get a key at https://cloud.cerebras.ai (1M tokens/day free, no
# credit card). Leave unset to skip.
CEREBRAS_API_KEY=
# Set to exercise a non-default backend order for evaluation only - see
# config.py's GENERATION_BACKEND_ORDER_OVERRIDE handling.
GENERATION_BACKEND_ORDER_OVERRIDE=

# Environment
DEBUG=true
LOG_LEVEL=INFO

# API auth (required on /query, /query_audio when publicly deployed)
RAG_API_KEY=

# Local LLM (fallback generation backend)
LOCAL_LLM_MODEL_PATH=models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
LOCAL_LLM_N_GPU_LAYERS=-1
